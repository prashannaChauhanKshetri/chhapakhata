# Keep the Docker build context small and free of secrets and local machine files.
.git
.github
**/.DS_Store

# Secrets and private keys: never part of an image
**/.env
**/.env.*
!**/.env.example
.certs
deploy/rclone

# Local environments and build output (rebuilt inside the images)
**/.venv
**/node_modules
**/__pycache__
**/*.pyc
frontend/dist
frontend/dev-dist
frontend/test-results
frontend/playwright-report
backend/staticfiles
backend/.coverage
backend/htmlcov
backend/.pytest_cache
backend/.ruff_cache
backend/.mypy_cache

# Data that lives in volumes, not images
backend/media
backend/backups
backend/logs
deploy/backups
