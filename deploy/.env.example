# Production settings for the shop computer. Copy to deploy/.env and fill in.
# The install script generates SECRET_KEY and POSTGRES_PASSWORD for you.

SECRET_KEY=
POSTGRES_PASSWORD=

# How staff open the app: the shop computer's LAN name or IP (comma-separated).
# Example for a computer at 192.168.1.10 named chhapakhata.local:
SITE_ADDRESS=chhapakhata.local
ALLOWED_HOSTS=chhapakhata.local,192.168.1.10,localhost
CSRF_TRUSTED_ORIGINS=https://chhapakhata.local,https://192.168.1.10
# HTTPS with Caddy's local certificate (default). For the plain-HTTP fallback set
# CADDYFILE=Caddyfile.http and SECURE_COOKIES=false.
CADDYFILE=Caddyfile
SECURE_COOKIES=true

# On an internet server (AWS EC2, see docs/deploy-aws.md) instead:
#   SITE_ADDRESS=demo.yourdomain.com        (or 13-233-1-2.sslip.io for the server's IP)
#   ALLOWED_HOSTS=demo.yourdomain.com
#   CSRF_TRUSTED_ORIGINS=https://demo.yourdomain.com
#   CADDYFILE=Caddyfile.public              (free Let's Encrypt certificate)
#   ACME_EMAIL=you@example.com              (certificate expiry notices)
#   GUNICORN_WORKERS=2                      (2 GB servers such as t3.small)
ACME_EMAIL=

TIME_ZONE=Asia/Kathmandu
MAX_ACTIVE_USERS=5
GUNICORN_WORKERS=3

# Backups: folder on the shop computer (ideally a second disk or USB drive).
BACKUP_HOST_DIR=./backups
BACKUP_HOUR=21
# Online copy with rclone (see docs/backup-restore.md). Leave empty to disable.
RCLONE_REMOTE=
RCLONE_CONFIG=/config/rclone/rclone.conf
