# Plain-HTTP fallback (no certificate to install on devices). Use only on a
# trusted, password-protected shop network: set CADDYFILE=Caddyfile.http and
# SECURE_COOKIES=false in .env.
{
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /django-admin/* {
		reverse_proxy api:8000
	}
	handle_path /static/* {
		root * /data/static
		file_server
	}
	handle_path /media/* {
		root * /data/media
		file_server
	}
	handle {
		root * /srv/app
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# The service worker and app manifest must be re-checked on every visit,
		# or installed phones would keep running an old version.
		@app_shell path /sw.js /manifest.webmanifest /index.html /
		header @app_shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
