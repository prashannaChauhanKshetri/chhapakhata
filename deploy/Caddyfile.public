# Internet-facing server (e.g. AWS EC2) with a real domain name.
# Caddy gets and renews a free Let's Encrypt certificate for SITE_ADDRESS
# automatically, so phones and browsers trust it with no setup. Ports 80 and
# 443 must be reachable from the internet for the certificate check.
{
	admin off
	email {$ACME_EMAIL}
	servers {
		# Cloudflare sits in front: believe forwarded addresses only from its servers
		# (list: https://www.cloudflare.com/ips/), so {client_ip} is the visitor,
		# not a Cloudflare server, and nobody else can choose their own address.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$SITE_ADDRESS} {

	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Public certificate, no plain-HTTP fallback: browsers may insist on HTTPS.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		# Largest upload is a 10 MB import file.
		request_body {
			max_size 12MB
		}
		reverse_proxy api:8000 {
			# The visitor's real address (see apps/core/client_ip.py).
			header_up X-Real-IP {client_ip}
		}
	}
	handle /django-admin/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {client_ip}
		}
	}
	handle_path /static/* {
		root * /data/static
		file_server
	}
	# Private uploads (the shop's stamp and signature) are never served as
	# files; the app hands them out to signed-in users only.
	handle /media/private/* {
		respond 404
	}
	handle_path /media/* {
		root * /data/media
		file_server
	}

	# The single-page app: unknown paths fall back to index.html.
	handle {
		root * /srv/app
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# The service worker and app manifest must be re-checked on every visit,
		# or installed phones would keep running an old version.
		@app_shell path /sw.js /manifest.webmanifest /index.html /
		header @app_shell Cache-Control "no-cache"
		# Only the app's own scripts may run: an injected script is refused.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src 'self' blob:; object-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		try_files {path} /index.html
		file_server
	}
}
