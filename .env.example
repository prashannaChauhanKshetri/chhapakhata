# Copy to `.env` (development) or `deploy/.env` (production) and fill in.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send CSRF-protected requests (scheme + host + port)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# The app connects as a non-superuser so row-level security keeps businesses
# apart (superusers skip it). `make db` creates the role.
DATABASE_URL=postgres://chhapakhata_app@localhost:5432/chhapakhata

# --- Business rules ---
# Contract allows up to 5 active user accounts.
MAX_ACTIVE_USERS=5
TIME_ZONE=Asia/Kathmandu

# --- Backups ---
BACKUP_DIR=./backups
# Daily backup time (24h, shop local time)
BACKUP_HOUR=21
# Optional rclone remote for the encrypted online copy, e.g. "shopbackup-crypt:chhapakhata"
RCLONE_REMOTE=
RCLONE_CONFIG=

# --- Security (production) ---
SECURE_COOKIES=false
