{
  "name": "chhapakhata-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ChhapaKhata web app: orders, production board, stock, billing and reports.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:types": "openapi-typescript ../backend/schema.yml -o src/api/schema.d.ts --default-non-nullable false",
    "fonts:pdf": "node scripts/copy-pdf-fonts.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@mantine/charts": "9.6.3",
    "@mantine/core": "9.6.3",
    "@mantine/dates": "9.6.3",
    "@mantine/form": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@mantine/modals": "9.6.3",
    "@mantine/notifications": "9.6.3",
    "@tabler/icons-react": "3.44.0",
    "@tanstack/react-query": "5.104.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "i18next": "25.10.10",
    "mantine-datatable": "9.4.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "15.7.4",
    "react-router": "7.18.4",
    "recharts": "3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.30",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
